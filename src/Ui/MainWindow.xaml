<!-- The main window. Loaded at runtime by MainWindow.cs, which finds the named elements and wires them up. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskSpace;assembly=DiskSpaceAnalyzer"
        Title="Disk Space Analyzer" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="244"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Title bar -->
    <Grid Grid.ColumnSpan="2">
      <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
        <Image x:Name="AppIconImage" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Disk Space Analyzer" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"/>
        <Border x:Name="AdminBadge" Visibility="Collapsed" Margin="10,0,0,0" Padding="7,1" CornerRadius="4" Background="{DynamicResource AccentTint}">
          <TextBlock Text="Administrator" FontSize="11" Foreground="{DynamicResource AccentText}"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize"/>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize"/>
        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Close"/>
      </StackPanel>
    </Grid>

    <!-- Navigation pane -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,4,0,0">
        <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;"/><TextBlock Text="Home" Margin="14,0,0,0"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavOverview" GroupName="Nav" Style="{StaticResource NavItem}" IsEnabled="False">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEB05;"/><TextBlock Text="Overview" Margin="14,0,0,0"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavExplore" GroupName="Nav" Style="{StaticResource NavItem}" IsEnabled="False">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEC50;"/><TextBlock Text="Explore" Margin="14,0,0,0"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavFiles" GroupName="Nav" Style="{StaticResource NavItem}" IsEnabled="False">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;"/><TextBlock Text="Largest files" Margin="14,0,0,0"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavCleanup" GroupName="Nav" Style="{StaticResource NavItem}" IsEnabled="False">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE90F;"/><TextBlock Text="Clean up" Margin="14,0,0,0"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavMove" GroupName="Nav" Style="{StaticResource NavItem}" IsEnabled="False">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8DE;"/><TextBlock Text="Move" Margin="14,0,0,0"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavProtect" GroupName="Nav" Style="{StaticResource NavItem}">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;"/><TextBlock Text="Protect" Margin="14,0,0,0"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavDisks" GroupName="Nav" Style="{StaticResource NavItem}">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;"/><TextBlock Text="Virtual disks" Margin="14,0,0,0"/></StackPanel>
        </RadioButton>
      </StackPanel>

      <!-- What is loaded right now -->
      <Border x:Name="ScanContext" Grid.Row="1" VerticalAlignment="Top" Margin="16,20,16,0" Padding="12,10" CornerRadius="6"
              Background="{DynamicResource SubtleHover}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Current scan" Style="{StaticResource Caption}"/>
          <TextBlock x:Name="ScanContextPath" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="ScanContextDetail" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Margin="0,0,0,10">
        <Button x:Name="AdminButton" Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Margin="8,2" Height="38" Padding="14,0">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA18;"/><TextBlock Text="Run as administrator" Margin="14,0,0,0"/></StackPanel>
        </Button>
        <Button x:Name="ThemeButton" Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Margin="8,2" Height="38" Padding="14,0">
          <StackPanel Orientation="Horizontal"><TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE706;"/><TextBlock x:Name="ThemeLabel" Text="Theme: System" Margin="14,0,0,0"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Content layer -->
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource LayerBg}" BorderBrush="{DynamicResource LayerBorder}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <Grid x:Name="Pages">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HOME -->
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,32,40,32">
            <TextBlock Style="{StaticResource Title}" Text="What's taking up space?"/>
            <TextBlock Style="{StaticResource BodySecondary}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"
                       Text="Pick a drive or folder to scan. Scanning only reads your files. Nothing changes until you choose an action."/>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Drives"/>
            <ItemsControl x:Name="DriveList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource CardButton}" Width="330" Margin="0,0,14,14" Tag="drive" ToolTip="{Binding Tooltip}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xEDA2;" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <Grid>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}"/>
                          <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiary}"/>
                        </Grid>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,12"/>
                        <Grid Height="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding UsedWidth}"/>
                            <ColumnDefinition Width="{Binding FreeWidth}"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{Binding TrackBrush}"/>
                          <Border CornerRadius="4" Background="{Binding FillBrush}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                          <TextBlock Text="{Binding FreeText}" Style="{StaticResource Caption}"/>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding WarningVisibility}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource MeterCritical}"/>
                            <TextBlock Text="Almost full" Style="{StaticResource Caption}" Margin="5,0,0,0"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,18,0,10" Text="Folders"/>
            <WrapPanel x:Name="FolderShortcuts"/>
          </StackPanel>
        </ScrollViewer>

        <!-- SCANNING -->
        <Grid x:Name="ScanPage" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
            <local:ArcGauge x:Name="ScanGauge" Width="128" Height="128" HorizontalAlignment="Center"
                            TrackBrush="{DynamicResource MeterTrack}" FillBrush="{DynamicResource MeterFill}"
                            Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="ScanTitle" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,28,0,0" Text="Scanning"/>
            <TextBlock x:Name="ScanStats" Style="{StaticResource BodySecondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="ScanCurrent" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" MaxWidth="560"/>
            <Button x:Name="CancelScanButton" Content="Cancel" HorizontalAlignment="Center" Margin="0,28,0,0" MinWidth="120"/>
          </StackPanel>
        </Grid>

        <!-- OVERVIEW -->
        <ScrollViewer x:Name="OverviewPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,32,40,32">
            <Grid>
              <StackPanel>
                <TextBlock x:Name="OverviewTitle" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock x:Name="OverviewSubtitle" Style="{StaticResource BodySecondary}" TextWrapping="NoWrap"/>
                  <Button x:Name="ProblemsLink" Style="{StaticResource LinkButton}" Margin="10,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="RescanButton" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14"/><TextBlock Text="Rescan" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <Button x:Name="ExportButton">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14"/><TextBlock Text="Export CSV" Margin="8,0,0,0"/></StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="24,22">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="HeroLabel" Style="{StaticResource Caption}" FontSize="14" Text="Space used"/>
                  <TextBlock x:Name="HeroValue" Style="{StaticResource Hero}" Margin="0,2,0,0"/>
                  <Grid x:Name="CapacityMeter" Height="8" Margin="0,12,24,8"/>
                  <TextBlock x:Name="HeroNote" Style="{StaticResource Caption}"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource Divider}" Margin="8,4,32,4"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock x:Name="StatFreeLabel" Style="{StaticResource Caption}" Text="Free space"/>
                  <TextBlock x:Name="StatFree" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Caption}" Text="Files"/>
                  <TextBlock x:Name="StatFiles" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Caption}" Text="Folders"/>
                  <TextBlock x:Name="StatFolders" Style="{StaticResource StatValue}"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,20">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource CardTitle}" Text="What's using space"/>
                  <Button x:Name="ExploreTypesLink" Style="{StaticResource LinkButton}" Content="Explore" HorizontalAlignment="Right"/>
                </Grid>
                <Grid x:Name="CategoryBar" Height="16" Margin="0,18,0,18"/>
                <ItemsControl x:Name="CategoryLegend">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource RowButton}" Margin="-10,0,14,0" Tag="category" ToolTip="Show these files in Explore">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="56"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="11" Height="11" CornerRadius="3" Background="{Binding Swatch}" HorizontalAlignment="Left"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="24,20">
                <StackPanel>
                  <Grid Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Largest folders"/>
                    <Button x:Name="ExploreFoldersLink" Style="{StaticResource LinkButton}" Content="Explore" HorizontalAlignment="Right"/>
                  </Grid>
                  <ItemsControl x:Name="TopFolders">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource RowButton}" Tag="folder">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="26"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="80"/>
                              <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Opacity="{Binding Opacity}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right"/>
                            <Grid Grid.Column="3" Height="6" Margin="14,0,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ShareWidth}"/>
                                <ColumnDefinition Width="{Binding RestWidth}"/>
                              </Grid.ColumnDefinitions>
                              <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource MeterTrack}"/>
                              <Border CornerRadius="3" Background="{DynamicResource MeterFill}"/>
                            </Grid>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20">
                <StackPanel>
                  <Grid Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Worth a look"/>
                    <Button x:Name="AllInsightsLink" Style="{StaticResource LinkButton}" Content="See all" HorizontalAlignment="Right"/>
                  </Grid>
                  <ItemsControl x:Name="TopInsights">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource RowButton}" Tag="insight">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentTint}" HorizontalAlignment="Left">
                              <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="NoInsights" Style="{StaticResource BodySecondary}" Visibility="Collapsed"
                             Text="Nothing stands out. Your largest items are listed under Explore and Largest files."/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- EXPLORE -->
        <Grid x:Name="ExplorePage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="24,18,24,12">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Alt+Left)"/>
              <Button x:Name="UpButton" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Up one level (Backspace)" Margin="2,0,0,0"/>
              <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="ExploreSummary" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="1" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" MinWidth="360"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0,6,0,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="20,8,24,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="118"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource Caption}"/>
                  <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="Share" Style="{StaticResource Caption}" Margin="16,0,0,0"/>
                </Grid>
                <ListBox x:Name="EntryList" Grid.Row="1" ItemContainerStyle="{StaticResource ListItem}" Padding="4,0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="86"/>
                          <ColumnDefinition Width="118"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Opacity="{Binding Opacity}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="{Binding Opacity}"/>
                        <Grid Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Grid Height="6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding ShareWidth}"/>
                              <ColumnDefinition Width="{Binding RestWidth}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource MeterTrack}"/>
                            <Border CornerRadius="3" Background="{DynamicResource MeterFill}"/>
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <local:TreemapView x:Name="Treemap" Focusable="True"/>
                <WrapPanel x:Name="TreemapLegend" Grid.Row="1" Margin="4,12,0,0"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- LARGEST FILES -->
        <Grid x:Name="FilesPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="40,32,40,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="Largest files"/>
              <TextBlock x:Name="FilesCount" Style="{StaticResource BodySecondary}" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBox x:Name="FilesSearch" Style="{StaticResource SearchBox}" Width="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Tag="Search by name or folder"/>
          </Grid>
          <WrapPanel x:Name="FileFilters" Grid.Row="1" Margin="40,18,40,8"/>
          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="40,0,40,0" Padding="0,6,0,6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Margin="20,8,26,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="3" Text="Modified" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="4" Text="Size" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              </Grid>
              <ListBox x:Name="FileList" Grid.Row="1" ItemContainerStyle="{StaticResource TallListItem}" Padding="4,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="86"/>
                      </Grid.ColumnDefinitions>
                      <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Swatch}"/>
                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource Caption}" FontSize="13" Margin="8,0,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding DateText}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="4" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="FilesEmpty" Grid.Row="1" Style="{StaticResource BodySecondary}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Visibility="Collapsed" Text="No files match."/>
            </Grid>
          </Border>
        </Grid>

        <!-- CLEAN UP -->
        <ScrollViewer x:Name="CleanupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,32,40,32">
            <TextBlock Style="{StaticResource Title}" Text="Clean up"/>
            <TextBlock Style="{StaticResource BodySecondary}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Suggestions from your last scan, largest first. Review each one. Nothing is removed without asking you, and removed items go to the Recycle Bin."/>
            <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="24,22">
              <Grid>
                <StackPanel>
                  <TextBlock Style="{StaticResource Caption}" FontSize="14" Text="Worth a look"/>
                  <TextBlock x:Name="CleanupTotal" Style="{StaticResource Hero}" Margin="0,2,0,0"/>
                  <TextBlock x:Name="CleanupNote" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="DiskCleanupButton" HorizontalContentAlignment="Left" Margin="0,0,0,8" MinWidth="210">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14"/><TextBlock Text="Open Disk Cleanup" Margin="10,0,0,0"/></StackPanel>
                  </Button>
                  <Button x:Name="StorageSettingsButton" HorizontalContentAlignment="Left" MinWidth="210">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14"/><TextBlock Text="Open storage settings" Margin="10,0,0,0"/></StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <ItemsControl x:Name="InsightList" Margin="0,16,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                          <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,24,0">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="15"/>
                          <TextBlock Text="{Binding Description}" Style="{StaticResource BodySecondary}" FontSize="13" Margin="0,3,0,0"/>
                          <ToggleButton x:Name="ShowItems" Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="{Binding ItemsVisibility}">
                            <ToggleButton.Template>
                              <ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                                  <TextBlock Text="{Binding ItemsLabel}" Foreground="{DynamicResource AccentText}" FontSize="13"/>
                                  <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="6,1,0,0" Foreground="{DynamicResource AccentText}"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </ToggleButton.Template>
                          </ToggleButton>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding SizeText}" Style="{StaticResource Subtitle}" HorizontalAlignment="Right"/>
                          <Button Content="{Binding ActionText}" Tag="insight-action" Visibility="{Binding ActionVisibility}" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Items}" Margin="56,12,0,0"
                                    Visibility="{Binding IsChecked, ElementName=ShowItems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"/>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                              <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Style="{StaticResource IconButton}" Content="&#xEC50;" Tag="item-show" ToolTip="Show in Explorer" Width="32" Height="32"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Tag="item-recycle" ToolTip="Move to Recycle Bin"
                                        Width="32" Height="32" Visibility="{Binding RecycleVisibility}"/>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- MOVE -->
        <ScrollViewer x:Name="MovePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,32,40,32">
            <TextBlock Style="{StaticResource Title}" Text="Move to other drives"/>
            <TextBlock Style="{StaticResource BodySecondary}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Large items from your last scan that would be better kept on another drive, based on what they are, when they last changed and which drives you have. Every copy is checked byte for byte, and nothing is removed until it has passed."/>
            <ItemsControl x:Name="MoveDrives" Margin="0,24,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Width="290" Margin="0,0,12,12" Padding="18,14">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Tag}" Margin="10,0,0,0" Visibility="{Binding ScannedVisibility}">
                          <TextBlock Text="This scan" FontSize="12"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding FreeText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
                      <TextBlock Text="{Binding Purpose}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="MoveProgressCard" Style="{StaticResource Card}" Margin="0,4,0,12" Padding="20,16" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <TextBlock x:Name="MoveProgressTitle" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                  <Button x:Name="MoveCancel" Content="Cancel" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="MoveProgressBar" Style="{StaticResource ThinProgress}" Maximum="1000" Margin="0,12,0,0"/>
                <TextBlock x:Name="MoveProgressText" Style="{StaticResource Caption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>

            <TextBlock x:Name="MoveSummary" Style="{StaticResource Subtitle}" Margin="0,8,0,12" TextWrapping="Wrap"/>
            <ItemsControl x:Name="MoveList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="16,0,24,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                          <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding KindName}" FontSize="12"/></Border>
                          <Border Style="{StaticResource Tag}" Visibility="{Binding UsageVisibility}"><TextBlock Text="{Binding Usage}" FontSize="12"/></Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource BodySecondary}" FontSize="13" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <TextBlock Style="{StaticResource Icon}" Text="{Binding TargetGlyph}" FontSize="13" Foreground="{Binding TargetBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding TargetText}" Margin="8,0,0,0" Foreground="{Binding TargetBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Subtitle}" HorizontalAlignment="Right"/>
                        <Button Content="{Binding ActionText}" Tag="move-primary" Style="{Binding ActionStyle}" MinWidth="170" Margin="0,10,0,0"/>
                        <Button Content="{Binding SecondaryText}" Tag="move-secondary" MinWidth="170" Margin="0,8,0,0" Visibility="{Binding SecondaryVisibility}"/>
                        <Button Content="Show in Explorer" Tag="move-show" Style="{StaticResource LinkButton}" FontSize="13" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- PROTECT -->
        <ScrollViewer x:Name="ProtectPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,32,40,32">
            <TextBlock Style="{StaticResource Title}" Text="Protect"/>
            <TextBlock Style="{StaticResource BodySecondary}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Protect will show which files would hurt if they leaked and which would hurt if a drive died. This build has the ground rules; findings arrive in the next stage. Everything below is generated from the program itself, so it describes this build, not a plan."/>
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,28,0,12" Text="What Protect reads"/>
            <StackPanel x:Name="ProtectInfo"/>
          </StackPanel>
        </ScrollViewer>

        <!-- VIRTUAL DISKS -->
        <ScrollViewer x:Name="DisksPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,32,40,32">
            <Grid>
              <TextBlock Style="{StaticResource Title}" Text="Virtual disks"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel x:Name="DisksBusy" Orientation="Horizontal" Margin="0,0,16,0" Visibility="Collapsed">
                  <local:Spinner Width="18" Height="18" FillBrush="{DynamicResource Accent}"/>
                  <TextBlock x:Name="DisksBusyText" Text="Working…" Style="{StaticResource Caption}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="DisksRefresh">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14"/><TextBlock Text="Refresh" Margin="8,0,0,0"/></StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource BodySecondary}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="WSL and Docker keep each Linux system in one virtual disk file. The file grows when Linux needs space but never shrinks on its own. Clean up inside first, then shrink the file to give the space back to Windows."/>
            <ItemsControl x:Name="DiskList" Margin="0,24,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentTint}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="16,0,24,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="15"/>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                          <StackPanel Width="130">
                            <TextBlock Text="Disk file" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding FileSizeText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Width="130">
                            <TextBlock Text="Used inside" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding UsedText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Width="160">
                            <TextBlock Text="Can be freed" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding FreeText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{Binding FreeBrush}"/>
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="{Binding NoteVisibility}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="{Binding CleanText}" Tag="disk-clean" Visibility="{Binding CleanVisibility}" MinWidth="170" Margin="0,0,0,8"/>
                        <Button Content="Shrink…" Tag="disk-shrink" Style="{StaticResource AccentButton}" MinWidth="170"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DisksEmpty" Style="{StaticResource BodySecondary}" Visibility="Collapsed" Margin="0,8,0,0"
                       Text="No WSL or Docker disks were found on this PC."/>
            <Border x:Name="DiskLogCard" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="20,16" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Activity" Style="{StaticResource BodyStrong}" Margin="0,0,0,10"/>
                <TextBox x:Name="DiskLog" Style="{StaticResource LogBox}" MaxHeight="300"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Actions for the selected item (Explore and Largest files) -->
        <Border x:Name="SelectionBar" Grid.Row="1" Style="{StaticResource Card}" Margin="24,12,24,18" Padding="14,10" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="SelIcon" Width="32" Height="32" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
              <TextBlock x:Name="SelName" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="SelDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SelOpen" Style="{StaticResource SubtleButton}" ToolTip="Open">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="14"/><TextBlock Text="Open" Margin="8,0,0,0"/></StackPanel>
              </Button>
              <Button x:Name="SelExplorer" Style="{StaticResource SubtleButton}" ToolTip="Show in File Explorer">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEC50;" FontSize="14"/><TextBlock Text="Show in Explorer" Margin="8,0,0,0"/></StackPanel>
              </Button>
              <Button x:Name="SelCopy" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy path"/>
              <Button x:Name="SelRescan" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Rescan this folder"/>
              <Button x:Name="SelShrink" Style="{StaticResource SubtleButton}" ToolTip="Clean up and shrink this virtual disk">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="14"/><TextBlock Text="Shrink" Margin="8,0,0,0"/></StackPanel>
              </Button>
              <Button x:Name="SelRecycle" Style="{StaticResource DangerButton}" Margin="8,0,0,0" ToolTip="Move to Recycle Bin">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14"/><TextBlock Text="Delete" Margin="8,0,0,0"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Notification -->
    <Border x:Name="Toast" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
            Padding="16,11" CornerRadius="8" Background="{DynamicResource ToastBg}" Visibility="Collapsed" MaxWidth="720">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Foreground="{DynamicResource ToastText}" Text="&#xE73E;"/>
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource ToastText}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>

    <!-- Dialogs -->
    <Grid x:Name="DialogLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed">
      <Rectangle Fill="{DynamicResource Smoke}"/>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
        <Border CornerRadius="8" Background="{DynamicResource DialogBg}">
          <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.3"/>
          </Border.Effect>
        </Border>
        <Border CornerRadius="8" Background="{DynamicResource DialogBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="24,22,24,24">
              <TextBlock x:Name="DialogTitle" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/>
              <ContentControl x:Name="DialogBody" Margin="0,12,0,0" Focusable="False"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource CardBgSecondary}" CornerRadius="0,0,8,8" Padding="24,18"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DialogPrimary" Style="{StaticResource AccentButton}"/>
                <Button x:Name="DialogSecondary" Grid.Column="2" Content="Cancel"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
